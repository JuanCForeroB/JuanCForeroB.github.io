{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "width": 600,
  "height": 320,
  "padding": 20,
  "title": {
    "text": "Inflation across four G7 economies",
    "subtitle": [
      "France, Germany, the United Kingdom and the United States",
      "Source: OECD | Data from 2000 onwards"
    ],
    "anchor": "start",
    "fontSize": 20,
    "fontWeight": "bold",
    "color": "#18324A",
    "subtitleFontSize": 11,
    "subtitleColor": "#64748B",
    "subtitlePadding": 8,
    "offset": 20
  },
  "data": {
    "url": "https://raw.githubusercontent.com/RDeconomist/RDeconomist.github.io/main/charts/ONSinflation/data_OECD_inflation2.csv",
    "format": {"type": "csv", "parse": {"TIME": "date", "Value": "number"}}
  },
  "transform": [
    {"filter": {"field": "LOCATION", "oneOf": ["FRA", "DEU", "GBR", "USA"]}},
    {"filter": "year(datum.TIME) >= 2000"},
    {"calculate": "datum.Value / 100", "as": "inflation"}
  ],
  "layer": [
    {
      "mark": {"type": "rule", "color": "#94A3B8", "strokeWidth": 1},
      "encoding": {"y": {"datum": 0, "type": "quantitative"}}
    },
    {
      "params": [
        {
          "name": "countrySelection",
          "select": {"type": "point", "fields": ["Country"]},
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "linear",
        "strokeWidth": 2.5,
        "strokeCap": "round",
        "strokeJoin": "round"
      },
      "encoding": {
        "x": {
          "field": "TIME",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y",
            "tickCount": 6,
            "labelAngle": 0,
            "grid": false
          }
        },
        "y": {
          "field": "inflation",
          "type": "quantitative",
          "title": "Inflation rate (%)",
          "scale": {"zero": true},
          "axis": {"format": ".0%", "tickCount": 6}
        },
        "color": {
          "field": "Country",
          "type": "nominal",
          "title": null,
          "scale": {"range": ["#0072B2", "#D55E00", "#009E73", "#CC79A7"]},
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "stroke",
            "symbolStrokeWidth": 3,
            "labelFontSize": 11,
            "offset": 15
          }
        },
        "opacity": {
          "condition": {"param": "countrySelection", "value": 1},
          "value": 0.15
        },
        "tooltip": [
          {"field": "Country", "type": "nominal", "title": "Country"},
          {
            "field": "TIME",
            "type": "temporal",
            "title": "Date",
            "format": "%b %Y"
          },
          {
            "field": "inflation",
            "type": "quantitative",
            "title": "Inflation",
            "format": ".1%"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 11,
      "labelColor": "#64748B",
      "labelPadding": 8,
      "titleFontSize": 11,
      "titleFontWeight": "normal",
      "titleColor": "#475569",
      "titlePadding": 12,
      "gridColor": "#E2E8F0",
      "gridDash": [3, 3]
    }
  }
}
