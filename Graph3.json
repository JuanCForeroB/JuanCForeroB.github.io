{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "GDP growth of Brazil",
    "anchor": "start",
    "subtitle": "Source: IGBE through ECO API",
    "fontSize": "14",
    "subtitleFontSize": "12",
    "color": "#000000",
    "subtitleColor": "#000000"
  },
  "height": "250",
  "width": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "#FFFDF8",
  "view": {
    "fill": "#FFFDF8",
    "strokeOpacity": 0
  },
  "data": {
    "url": "https://api.economicsobservatory.com/bra/grow?vega",
    "format": {
      "type": "json"
    }
  },
  "mark": {
    "type": "line",
    "color": "#0a68ff",
    "strokeWidth": "2"
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {
        "title": "Time",
        "titleColor": "#122B39",
        "grid": false
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {
        "title": "Rate % ",
        "titleColor": "#122B39",
        "grid": false
      }
    }
  }
}
