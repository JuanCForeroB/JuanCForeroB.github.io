{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Bank Rate",
    "anchor": "start",
    "subtitle": "Source: BoE through ECO API",
    "fontSize": "14",
    "subtitleFontSize": "12",
    "color": "#000000",
    "subtitleColor": "#000000"
  },
  "height": "250",
  "width": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "##FFFDF8",
  "view": {
    "fill": "#FFFDF8",
    "strokeOpacity": 0
  },
  "data": {
    "url": "https://api.economicsobservatory.com/gbr/brate?vega",
    "format": {
      "type": "json"
    }
  },
  "mark": {
    "type": "bar",
    "color": "#790119",
    "strokeWidth": "1"
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "axis": {
        "title": "Time",
        "titleColor": "#122B39",
        "grid": false
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "axis": {
        "title": "Rate % ",
        "titleColor": "#122B39",
        "grid": false
      }
    }
  }
}