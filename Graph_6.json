{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "#FFFDF8",
  "padding": 20,
  "title": {
    "text": "Colombia’s performance in PISA",
    "subtitle": [
      "Mathematics, reading and science | 2006–2022",
      "Source: OECD"
    ],
    "anchor": "start",
    "color": "#123F49",
    "fontSize": 19,
    "subtitleFontSize": 11,
    "subtitleColor": "#64748B",
    "offset": 20
  },
  "width": 650,
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/JuanCForeroB/JuanCForeroB.github.io/refs/heads/main/COL_PISA_serie.csv",
    "format": {"type": "csv", "parse": {"Year": "date"}}
  },
  "transform": [
    {"filter": "year(datum.Year) <= 2022"},
    {"fold": ["Mathematics", "Reading", "Science"], "as": ["Subject", "Score"]}
  ],
  "mark": {"type": "point", "filled": true, "size": 90, "opacity": 1},
  "encoding": {
    "x": {
      "field": "Year",
      "type": "temporal",
      "title": null,
      "axis": {"format": "%Y", "labelAngle": 0, "tickCount": 6, "grid": false}
    },
    "y": {
      "field": "Score",
      "type": "quantitative",
      "title": "PISA score",
      "scale": {"domain": [350, 450], "zero": false},
      "axis": {"tickCount": 6}
    },
    "color": {
      "field": "Subject",
      "type": "nominal",
      "scale": {
        "domain": ["Mathematics", "Reading", "Science"],
        "range": ["#123F49", "#D97706", "#397DB8"]
      },
      "legend": {"title": null, "orient": "top"}
    },
    "shape": {
      "field": "Subject",
      "type": "nominal",
      "scale": {
        "domain": ["Mathematics", "Reading", "Science"],
        "range": ["circle", "triangle-up", "cross"]
      },
      "legend": {"title": null, "orient": "top"}
    },
    "angle": {
      "condition": {"test": "datum.Subject === 'Science'", "value": 45},
      "value": 0
    },
    "tooltip": [
      {"field": "Year", "type": "temporal", "format": "%Y", "title": "Year"},
      {"field": "Subject", "type": "nominal", "title": "Subject"},
      {
        "field": "Score",
        "type": "quantitative",
        "format": ".0f",
        "title": "PISA score"
      }
    ]
  },
  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 11,
      "labelPadding": 8,
      "labelColor": "#475569",
      "titleColor": "#475569",
      "titleFontWeight": "normal",
      "titlePadding": 12,
      "gridColor": "#E3E8E5",
      "gridDash": [3, 3]
    }
  }
}